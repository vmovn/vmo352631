# PostgreSQL runs as a separate service. In production this points to Coolify PostgreSQL.
DATABASE_URI=

# Generate a long, random secret. Never commit a real value.
PAYLOAD_SECRET=

# Development defaults to migration-first. Enable push only for a disposable local sandbox.
PAYLOAD_DB_PUSH=false

# Canonical origin used by Payload SEO previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional idempotent seed administrator. Supply only in local/CI environment.
PAYLOAD_SEED_ADMIN_EMAIL=
PAYLOAD_SEED_ADMIN_PASSWORD=
